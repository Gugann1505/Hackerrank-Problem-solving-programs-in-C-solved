#include <stdio.h>

int simpleArraySum(int n, int ar[]) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += ar[i];
    }
    return total;
}

int main() {
    int n;
    scanf("%d", &n);
    int ar[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &ar[i]);
    }
    printf("%d\n", simpleArraySum(n, ar));
    return 0;
}
