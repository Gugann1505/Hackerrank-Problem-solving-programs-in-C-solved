#include <stdio.h>
#include <stdlib.h>

int diagonalDifference(int n, int matrix[n][n]) {
    int leftSum = 0;
    int rightSum = 0;

    for (int i = 0; i < n; i++) {
        leftSum += matrix[i][i];          // Primary diagonal
        rightSum += matrix[i][n - 1 - i]; // Secondary diagonal
    }

    return abs(leftSum - rightSum);
}

int main() {
    int n;
    scanf("%d", &n);
    int matrix[n][n];
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }
    printf("%d\n", diagonalDifference(n, matrix));
    return 0;
}
